<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用默认主题（IME 窗口使用）：保持与原项目完全一致的极简主题。
         原项目 IME 在 android:Theme 下正常弹出；fork 曾改成 DeviceDefault.Light
         的 Material 主题（windowBackground/状态栏着色等），IME 窗口行为随之改变。
         排查"键盘不弹出"时先回归原样，新样式仅给 MainActivity 单独使用。 -->
    <style name="AppTheme" parent="android:Theme">
    </style>

    <!-- 主界面主题：蓝紫渐变风格（仅 MainActivity，不影响 IME 窗口） -->
    <style name="MainTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/light_gray</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 投屏播放器：沉浸式黑色全屏 -->
    <style name="PlayerTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorControlHighlight">#44ffffff</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- 软键盘按键样式（保留原有） -->
    <style name="btn_input_style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#fff</item>
        <item name="android:layout_marginRight">5dp</item>
        <item name="android:background">@drawable/key</item>
        <item name="android:onClick">onClick</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 主界面按钮样式：主色填充圆角按钮 -->
    <style name="MainButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:onClick">onClick</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MainButtonSecondary" parent="MainButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
    </style>
</resources>
